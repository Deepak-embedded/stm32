void PollUartBaudRate(void)
{
	uint8_t gpioVal = (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_6) << 1) |
	HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_7);
	static uint32_t prevBaudRate=115200;

	switch (gpioVal)
	{
		case BAUD_9600: selectedBaudRate = 9600; break;
		case BAUD_19200: selectedBaudRate = 19200; break;
		case BAUD_38400: selectedBaudRate = 38400; break;
		default: selectedBaudRate = 9600; break;
	}

	// Change baud only if different from previous
	if (selectedBaudRate != prevBaudRate)
	{
		prevBaudRate = selectedBaudRate;

		/* -------- UART3 -------- */
		HAL_UART_AbortReceive(&huart3);
		HAL_Delay(2);
		HAL_UART_DeInit(&huart3);
		huart3.Init.BaudRate = selectedBaudRate;
		HAL_UART_Init(&huart3);
		HAL_UART_Receive_IT(&huart3, &uart_rx_byte, 1);

		/* -------- UART1 -------- */
		HAL_UART_AbortReceive(&huart1);
		HAL_Delay(2);
		HAL_UART_DeInit(&huart1);
		huart1.Init.BaudRate = selectedBaudRate;
		HAL_UART_Init(&huart1);
		//HAL_UART_Receive_IT(&huart1, RxData2, sizeof(RxData2));

	}
}

